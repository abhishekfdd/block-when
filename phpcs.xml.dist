<?xml version="1.0"?>
<ruleset name="Block When">
	<description>Coding standards for the Block When plugin.</description>

	<file>.</file>

	<exclude-pattern>*/build/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<rule ref="WordPress-VIP-Go">
    <!-- These sniffs target JS files, which we lint with ESLint instead. -->
    <!-- Including them produces deprecation warnings in PHP_CodeSniffer 3.x -->
    <!-- and will break entirely in 4.x. -->
    <exclude name="WordPressVIPMinimum.JS.Window"/>
    <exclude name="WordPressVIPMinimum.JS.DangerouslySetInnerHTML"/>
    <exclude name="WordPressVIPMinimum.JS.InnerHTML"/>
    <exclude name="WordPressVIPMinimum.JS.StrippingTags"/>
    <exclude name="WordPressVIPMinimum.JS.StringConcat"/>
    <exclude name="WordPressVIPMinimum.JS.HTMLExecutingFunctions"/>
</rule>

	<config name="testVersion" value="7.4-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="text_domain" value="block-when"/>
	<config name="minimum_supported_wp_version" value="6.5"/>
</ruleset>
